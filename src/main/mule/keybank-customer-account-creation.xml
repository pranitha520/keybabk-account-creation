    <flow name="keybank-customer-account-creation-console">
        <http:listener config-ref="keybank-customer-account-creation-httpListenerConfig" path="/console/*">
            <http:response statusCode="#[vars.httpStatus default 200]">
                <http:headers>#[vars.outboundHeaders default {}]</http:headers>
            </http:response>
            <http:error-response statusCode="#[vars.httpStatus default 500]">
                <http:body>#[payload]</http:body>
                <http:headers>#[vars.outboundHeaders default {}]</http:headers>
            </http:error-response>
        </http:listener>
        <apikit:console config-ref="keybank-customer-account-creation-config" />
        <error-handler>
            <on-error-propagate type="APIKIT:NOT_FOUND">
                <ee:transform doc:name="Transform Message">
                    <ee:message>
                        <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{message: "Resource not found"}]]></ee:set-payload>
                    </ee:message>
                    <ee:variables>
                        <ee:set-variable variableName="httpStatus">404</ee:set-variable>
                    </ee:variables>
                </ee:transform>
            </on-error-propagate>
        </error-handler>
    </flow>
    <flow name="post:\createAccount:application\json:keybank-customer-account-creation-config">
		<logger level="INFO" doc:name="Logger-begin" doc:id="dbfcaa87-80a0-460a-b583-b2e32091ce34" message="---------Create customer account begins----------#[payload]"/>
		<set-variable value="#[attributes.queryParams.customerName]" doc:name="SetcustomerName" doc:id="a6c26369-e4f9-43d1-a37d-ac2dbc908c15" variableName="customerName"/>
		<set-variable value="#[attributes.queryParams.bank]" doc:name="Setbank" doc:id="42a9e964-ab2c-462e-86bb-ae20397bdcef" variableName="bank"/>
		<set-variable value="#[attributes.queryParams.accountType]" doc:name="SetaccountType" doc:id="ac1912a5-e35a-4631-ba1a-b2e4fd2ed17d" variableName="accountType"/>
		<set-variable value="#[attributes.queryParams.branchName]" doc:name="SetbranchName" doc:id="214bbd88-0103-463d-8526-edd92c60fdf6" variableName="branchName"/>
		<set-variable value="#[payload.mailID]" doc:name="SetEmail" doc:id="37998384-237f-4f0e-886b-5d06eda747bd" variableName="email"/>
		<set-variable value="#[payload.accountNumber]" doc:name="SetaccNum" doc:id="b0c260b6-d0de-4b86-9510-4252c00e003c" variableName="accNum"/>
		<set-variable value="#[[]]" doc:name="emptyList" doc:id="807975bc-ae96-4ce8-9d08-53d17f79b4db" variableName="inpPayload"/>
		<set-variable value="#[%dw 2.0&#10;output application/json&#10;---&#10;vars.inpPayload &lt;&lt; payload]" doc:name="add the input payload" doc:id="144fce73-0183-4b08-9861-eaa93f973320" variableName="inpPayload"/>
		<db:select doc:name="Select" doc:id="6d77e729-4315-41f2-9f9a-230c461eaad2" config-ref="Database_Config1">
			<db:sql ><![CDATA[SELECT CUSTOMER_ACCOUNT_NUMBER,BANK_NAME FROM CUSTOMER WHERE CUSTOMER_ACCOUNT_NUMBER= :accountNumber AND BANK_NAME = :bankName
]]></db:sql>
			<db:input-parameters ><![CDATA[#[{
	"accountNumber" : payload.accountNumber,
	"bankName": vars.bank
}]]]></db:input-parameters>
		</db:select>
		<choice doc:name="Choice" doc:id="74964b27-3624-4ae1-9089-7a420b91f0e7" >
			<when expression="#[sizeOf(payload) &gt;=1]">
				<ee:transform doc:name="Transform Message">
            <ee:message>
                <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
status : payload[0].CUSTOMER_ACCOUNT_NUMBER ++ "already exist"
}]]></ee:set-payload>
            </ee:message>
        </ee:transform>
				<logger level="INFO" doc:name="the record is exists in db" doc:id="28aaf5bb-d1e9-4164-8f99-082db2dec5e1" message="----the customer account already exist in db-------"/>
			</when>
			<otherwise >
				<db:insert doc:name="Insert" doc:id="c403f735-2d2c-4055-9d58-59f5bac130cd" config-ref="Database_Config1">
					<db:sql ><![CDATA[INSERT INTO CUSTOMER (
    CUSTOMER_NAME,
    CUSTOMER_ACCOUNT_NUMBER,
    ATM_PIN,
    BANK_NAME,
    ACCOUNT_TYPE,
    IFSC_CODE,
    BRANCH_NAME,
    TRANSACTION_TIMESTAMP,
    MAIL_ID,
    PHONE_NUMBER
) VALUES (
    :customerName,
    :customerAccountNumber,
    :atmPin,
    :bankName,
    :accountType,
    :ifscCode,
    :branchName,
    :time,
    :mailId,
    :phoneNumber
)
]]></db:sql>
					<db:input-parameters ><![CDATA[#[{
(vars.inpPayload map
	{
		"customerName": vars.customerName,
	"customerAccountNumber": $.accountNumber,
    "atmPin" : $.atmPin,
    "bankName": vars.bank,
    "accountType": vars.accountType,
    "ifscCode":$.ifscCode,
    "branchName":vars.branchName,
    "time":now(),
    "mailId":$.mailID,
    "phoneNumber": $.contact
		
	}
)
}]]]></db:input-parameters>
				</db:insert>
				<flow-ref doc:name="Flow Reference" doc:id="bb4773bc-f7e6-44f0-815a-f73f702b180d" name="keybank-customer-account-gmail" targetValue="#[vars.inpPayload]"/>
				<ee:transform doc:name="Transform Message" doc:id="446df15b-33a2-4ffa-a6b5-7f674a40ef99" >
					<ee:message >
						<ee:set-payload ><![CDATA[%dw 2.0
output application/json
---
{
	status : vars.inpPayload[0].accountNumber ++ "data inserted successfully"
}]]></ee:set-payload>
					</ee:message>
				</ee:transform>
				<logger level="INFO" doc:name="successful insertion" doc:id="caf3865a-5b58-44ea-95fc-04afc7bfbdfc" message="------------account created successfully for the given input------"/>
			</otherwise>
		</choice>
    </flow>
	<flow name="keybank-customer-account-gmail" doc:id="a03e1bd7-79c0-42e2-a3cf-22be13b14c71" >
		<logger level="INFO" doc:name="Logger" doc:id="1f55c154-a435-4df9-824e-da2ff4ec273d" message='#[["--------------before sending email---"] ++ vars.inpPayload]'/>
		<ee:transform doc:name="Transform Message" doc:id="4473003c-b4ff-48ff-89c0-03cc67b7ff77" >
			<ee:message >
				<ee:set-payload ><![CDATA[%dw 2.0
output application/json
---

"Congratulations! Your account is created successfully with account number with the account number"++ vars.accNum as String ++ "with" ++ vars.bank as String
]]></ee:set-payload>
			</ee:message>
		</ee:transform>
		<email:send doc:name="Send" doc:id="aead82f9-7a03-434d-aec7-87617cd50fc8" config-ref="Email_SMTP1" subject='#["(Congratulations ! Account Created in" ++ vars.bank as String]' fromAddress="${email.config.user}">
			<email:to-addresses>
				<email:to-address value="#[vars.email]" />
			</email:to-addresses>
			<email:body contentTransferEncoding="Binary">
			</email:body>
		</email:send>
		<logger level="INFO" doc:name="Logger" doc:id="6c8109a9-536e-4586-9d32-f174207909a7" message="------Email sent successfully---------"/>
	</flow>
</mule>
